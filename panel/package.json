{
  "name": "wpl7-panel",
  "version": "0.3.0-beta.2",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "Admin control panel + REST API for the WPL7 WordPress hosting stack",
  "scripts": {
    "dev": "concurrently -n api,web \"tsx watch src/index.ts\" \"vite --config web/vite.config.ts\"",
    "dev:api": "tsx watch src/index.ts",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.server.json && cp -R src/db/migrations dist/src/db/",
    "build:web": "vite build --config web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p web/tsconfig.json --noEmit && tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "locales:sync": "node scripts/sync-locales.mjs",
    "catalog:schema": "tsx scripts/catalog-schema.ts",
    "start": "node dist/src/index.js",
    "demo": "tsx scripts/demo-world.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/session": "^11.1.3",
    "@fastify/static": "^10.1.5",
    "@fastify/type-provider-zod": "^1.0.0",
    "@fastify/websocket": "^11.3.2",
    "@modelcontextprotocol/server": "2.3.0",
    "argon2": "^0.45.1",
    "better-sqlite3": "^13.0.3",
    "croner": "^10.0.1",
    "dockerode": "^5.0.1",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "mysql2": "^3.24.5",
    "ssh2": "^1.17.0",
    "uqr": "^0.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.13",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/dockerode": "^4.0.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.11",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "shell-quote": "^1.11.0"
  }
}
