{
  "common": {
    "idle_timeout": 15,
    "upload_mode": 1,
    "setstat_mode": 0,
    "rename_mode": 0,
    "symlink_mode": 0,
    "max_total_connections": 300,
    "max_per_host_connections": 20,
    "allow_self_connections": 0,
    "defender": {
      "enabled": true,
      "driver": "memory",
      "ban_time": 30,
      "ban_time_increment": 50,
      "threshold": 15,
      "score_invalid": 2,
      "score_valid": 1,
      "score_limit_exceeded": 3,
      "score_no_auth": 0,
      "observation_time": 30,
      "entries_soft_limit": 100,
      "entries_hard_limit": 150,
      "login_delay": {
        "success": 0,
        "password_failed": 1000
      }
    }
  },
  "sftpd": {
    "bindings": [
      {
        "port": 2022,
        "address": "",
        "apply_proxy_config": false
      }
    ],
    "max_auth_tries": 4,
    "host_keys": [
      "/etc/wpl7-ftp/host_ed25519",
      "/etc/wpl7-ftp/host_rsa"
    ],
    "password_authentication": true,
    "keyboard_interactive_authentication": true,
    "enabled_ssh_commands": [
      "md5sum",
      "sha1sum",
      "sha256sum",
      "cd",
      "pwd",
      "scp"
    ]
  },
  "ftpd": {
    "bindings": [
      {
        "port": 2121,
        "address": "",
        "apply_proxy_config": false,
        "tls_mode": 1,
        "certificate_file": "/etc/wpl7-ftp/ftps.crt",
        "certificate_key_file": "/etc/wpl7-ftp/ftps.key",
        "min_tls_version": 12,
        "force_passive_ip": "203.0.113.9",
        "passive_ip_overrides": [],
        "passive_host": "",
        "passive_connections_security": 0,
        "active_connections_security": 0
      }
    ],
    "passive_port_range": {
      "start": 30000,
      "end": 30015
    },
    "disable_active_mode": true,
    "enable_site": true
  },
  "webdavd": {
    "bindings": [
      {
        "port": 0
      }
    ]
  },
  "httpd": {
    "bindings": [
      {
        "port": 0,
        "enable_web_admin": false,
        "enable_web_client": false,
        "enable_rest_api": false
      }
    ]
  },
  "telemetry": {
    "bind_port": 0
  },
  "plugins": [],
  "data_provider": {
    "driver": "memory",
    "name": "/etc/wpl7-ftp/users.json",
    "naming_rules": 6,
    "password_caching": true,
    "track_quota": 0,
    "create_default_admin": false,
    "users_base_dir": "",
    "backups_path": "/var/lib/sftpgo/backups",
    "password_hashing": {
      "algo": "argon2id",
      "argon2_options": {
        "memory": 19456,
        "iterations": 2,
        "parallelism": 1
      }
    }
  }
}
