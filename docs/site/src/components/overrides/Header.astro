---
/**
 * Starlight's header with two changes: search sits in the middle of the bar, and a How to install
 * button ends it. Starlight hides its right-hand group (social icons, theme) below 50rem; the
 * button sits outside that group so it stays on a phone, where search folds to an icon.
 * Everything else is Starlight's own Header.astro.
 */
import config from 'virtual:starlight/user-config';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import InstallGuideButton from '../InstallGuideButton.astro';

const shouldRenderSearch =
  config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';
---

<div class="header">
  <div class="title-wrapper sl-flex">
    <SiteTitle />
  </div>
  <div class="sl-flex print:hidden">
    {shouldRenderSearch && <Search />}
  </div>
  <div class="sl-flex print:hidden end-group">
    <div class="sl-hidden md:sl-flex right-group">
      <div class="sl-flex social-icons">
        <SocialIcons />
      </div>
      <ThemeSelect />
    </div>
    <InstallGuideButton />
  </div>
</div>

<style>
  .header {
    display: flex;
    gap: var(--sl-nav-gap);
    justify-content: space-between;
    align-items: center;
    height: 100%;
  }

  .title-wrapper {
    overflow: clip;
    padding: 0.25rem;
    margin: -0.25rem;
    min-width: 0;
  }

  .end-group,
  .right-group,
  .social-icons {
    gap: 1rem;
    align-items: center;
  }
  .social-icons::after {
    content: '';
    height: 2rem;
    border-inline-end: 1px solid var(--sl-color-gray-5);
  }

  /* A 360-pixel phone fits the title, search and the button only with narrower gaps. */
  @media (max-width: 24rem) {
    .header {
      gap: 0.375rem;
    }
  }

  /* Equal outer columns put search in the middle of the bar. Where the two ends need more room
     than that, they take it from the search column, never the other way round. */
  @media (min-width: 50rem) {
    .header {
      display: grid;
      grid-template-columns: minmax(max-content, 1fr) minmax(auto, 22rem) minmax(max-content, 1fr);
      align-content: center;
    }
    .end-group {
      justify-self: end;
    }
  }
</style>
