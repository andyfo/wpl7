# WPL7 docs: static files under /docs, served as they are. Goes into the server block of the
# WordPress site, before WordPress's own `location /`. Apache and LiteSpeed use the .htaccess
# that is published with the files instead.

location /docs/ {
    # A directory answers with its index.html; /docs/sites/create redirects to .../create/.
    index index.html;
    try_files $uri $uri/ =404;
    error_page 404 /docs/404.html;
    add_header Cache-Control "public, max-age=300" always;

    # Content-hashed files never change under their name: keep them for a year.
    location ~ ^/docs/(_astro/|pagefind/(fragment|index)/|pagefind/pagefind\.[^/]+\.pf_meta$) {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }
}

