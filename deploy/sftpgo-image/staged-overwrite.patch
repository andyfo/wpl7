+
+// WPL7: staged overwrites for atomic uploads (deploy/sftpgo-image in https://github.com/andyfo/wpl7).
+
+package vfs
+
+import (
+	"github.com/drakkan/sftpgo/v2/internal/logger"
+)
+
+// CopyFileMode gives a staged replacement the permission bits of the file it replaces.
+// The replacement is a new file, so it would otherwise get the default mode instead.
+// A failure is logged, not returned: the upload itself can still succeed.
+func CopyFileMode(fs Fs, source, target string) {
+	info, err := fs.Lstat(source)
+	if err != nil || !info.Mode().IsRegular() {
+		return
+	}
+	if err := fs.Chmod(target, info.Mode().Perm()); err != nil {
+		fsLog(fs, logger.LevelWarn, "unable to give %q the mode of %q: %v", target, source, err)
+	}
+}
